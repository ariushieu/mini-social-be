# ==============================================================================
# Environment variables (Example Template)
# Copy this file to .env and fill in your actual values: cp .env.example .env
# ==============================================================================

# --- MySQL Setup ---
# MySQL root password (Administrative use only)
MYSQL_ROOT_PASSWORD=root_password_placeholder

# Initial database name
MYSQL_DATABASE=myapp_db

# Application credentials for database access
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password_placeholder

# --- Spring Boot App ---
# JDBC URL configuration (Note: 'db' is the service name if using Docker Compose)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true

# Reuse defined variables to ensure consistency
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}

# --- Email (Resend) ---
# Obtain your API Key from resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=no-reply@qhieu.dev

# --- JWT ---
# Recommendation: Use a random string of at least 32-64 characters
SECRET_KEY=your_base64_encoded_secret_key_min_256_bits_here

# --- Timezone ---
# Vietnam  -> TZ=Asia/Ho_Chi_Minh  MYSQL_TZ_OFFSET=+07:00
# Singapore -> TZ=Asia/Singapore   MYSQL_TZ_OFFSET=+08:00
TZ=Asia/Ho_Chi_Minh
MYSQL_TZ_OFFSET=+07:00

# --- Cloudinary ---
# Media storage configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Frontend ---
# Client application URL for CORS configuration
FRONTEND_URL=http://localhost:3000